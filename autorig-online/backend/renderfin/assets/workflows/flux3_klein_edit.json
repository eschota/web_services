{
  "_meta": {
    "title": "FLUX 3 Image Klein (distilled, int8) single-reference edit",
    "note": "Candidate under test 2026-10-16 (owner order). Needs ComfyUI >= 0.41.0 (Support Flux3-image #17064, ReferenceMultiLatent) and the gated files of black-forest-labs/flux-3-image-klein-comfy. Not routed: no routing.py entry until the farm test passes. License: FLUX Kommunity License v1.0.",
    "source": "Comfy-Org/workflow_templates templates/image_flux3_klein_distilled_image_edit.json"
  },
  "model": {"class_type": "UNETLoader", "inputs": {"unet_name": "flux3_image_klein_sd_int8_convrot.safetensors", "weight_dtype": "default"}},
  "clip": {"class_type": "CLIPLoader", "inputs": {"clip_name": "qwen3vl_4b_int8_convrot.safetensors", "type": "flux3", "device": "default"}},
  "vae": {"class_type": "VAELoader", "inputs": {"vae_name": "flux2-vae.safetensors"}},
  "reference_image": {"class_type": "LoadImage", "inputs": {"image": "$image"}},
  "positive": {"class_type": "CLIPTextEncode", "inputs": {"clip": ["clip", 0], "text": "$prompt"}},
  "negative": {"class_type": "ConditioningZeroOut", "inputs": {"conditioning": ["positive", 0]}},
  "reference": {"class_type": "ReferenceMultiLatent", "inputs": {"positive": ["positive", 0], "negative": ["negative", 0], "vae": ["vae", 0],
                "resolution": "resize", "resolution.megapixels": 1.0, "images.image0": ["reference_image", 0]}},
  "sample": {"class_type": "KSampler", "inputs": {"model": ["model", 0], "seed": 42, "steps": 16, "cfg": 1.0, "sampler_name": "euler",
             "scheduler": "simple", "positive": ["reference", 0], "negative": ["reference", 1], "latent_image": ["reference", 2], "denoise": 1.0}},
  "decode": {"class_type": "VAEDecode", "inputs": {"samples": ["sample", 0], "vae": ["vae", 0]}},
  "save": {"class_type": "SaveImage", "inputs": {"images": ["decode", 0], "filename_prefix": "$output_url"}}
}
