{
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "CyberRealisticPony_V18.0_F16.safetensors"
    }
  },
  "2": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "$prompt",
      "clip": [
        "8",
        0
      ]
    }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "$negative_prompt",
      "clip": [
        "8",
        0
      ]
    }
  },
  "4": {
    "class_type": "VAEEncode",
    "inputs": {
      "pixels": [
        "10",
        0
      ],
      "vae": [
        "1",
        2
      ]
    }
  },
  "5": {
    "class_type": "KSampler",
    "inputs": {
      "seed": 1,
      "steps": 50,
      "cfg": 5.0,
      "sampler_name": "dpmpp_2m_sde",
      "scheduler": "karras",
      "denoise": 0.65,
      "model": [
        "1",
        0
      ],
      "positive": [
        "2",
        0
      ],
      "negative": [
        "3",
        0
      ],
      "latent_image": [
        "4",
        0
      ]
    }
  },
  "6": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "5",
        0
      ],
      "vae": [
        "1",
        2
      ]
    }
  },
  "7": {
    "class_type": "SaveImage",
    "inputs": {
      "filename_prefix": "$output_url",
      "images": [
        "6",
        0
      ]
    }
  },
  "8": {
    "class_type": "CLIPSetLastLayer",
    "inputs": {
      "stop_at_clip_layer": -2,
      "clip": [
        "1",
        1
      ]
    }
  },
  "9": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "$image"
    }
  },
  "10": {
    "class_type": "ImageScale",
    "inputs": {
      "image": [
        "9",
        0
      ],
      "width": $width,
      "height": $height,
      "crop": "center",
      "upscale_method": "lanczos"
    }
  }
}
