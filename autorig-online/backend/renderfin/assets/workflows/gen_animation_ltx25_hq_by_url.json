{
 "model": {
  "class_type": "CheckpointLoaderSimple",
  "inputs": {
   "ckpt_name": "ltx10eros_v14_2989669.safetensors"
  },
  "_meta": {
   "title": "AUTORIG_10EROS_CHECKPOINT"
  }
 },
 "clip": {
  "class_type": "LTXAVTextEncoderLoader",
  "inputs": {
   "text_encoder": "gemma_3_12B_it_fp4_mixed.safetensors",
   "ckpt_name": "ltx10eros_v14_2989669.safetensors",
   "device": "default"
  },
  "_meta": {
   "title": "AUTORIG_10EROS_TEXT_ENCODER"
  }
 },
 "audio_vae": {
  "class_type": "LTXVAudioVAELoader",
  "inputs": {
   "ckpt_name": "ltx10eros_v14_2989669.safetensors"
  },
  "_meta": {
   "title": "AUTORIG_10EROS_AUDIO_VAE"
  }
 },
 "positive": {
  "class_type": "CLIPTextEncode",
  "inputs": {
   "text": "$prompt",
   "clip": [
    "clip",
    0
   ]
  },
  "_meta": {
   "title": "AUTORIG_POSITIVE_PROMPT"
  }
 },
 "negative": {
  "class_type": "CLIPTextEncode",
  "inputs": {
   "text": "$negative_prompt",
   "clip": [
    "clip",
    0
   ]
  },
  "_meta": {
   "title": "AUTORIG_NEGATIVE_PROMPT"
  }
 },
 "conditioning": {
  "class_type": "LTXVConditioning",
  "inputs": {
   "positive": [
    "positive",
    0
   ],
   "negative": [
    "negative",
    0
   ],
   "frame_rate": $fps
  },
  "_meta": {
   "title": "AUTORIG_INPUT_CONDITIONING"
  }
 },
 "start_frame": {
  "class_type": "LoadImage",
  "inputs": {
   "image": "$image"
  },
  "_meta": {
   "title": "AUTORIG_START_FRAME"
  }
 },
 "start_scale": {
  "class_type": "ImageScale",
  "inputs": {
   "image": [
    "start_frame",
    0
   ],
   "width": $width,
   "height": $height,
   "crop": "center",
   "upscale_method": "lanczos"
  }
 },
 "start_preprocess": {
  "class_type": "LTXVPreprocess",
  "inputs": {
   "image": [
    "start_scale",
    0
   ],
   "img_compression": 18
  }
 },
 "video_latent": {
  "class_type": "EmptyLTXVLatentVideo",
  "inputs": {
   "width": $width,
   "height": $height,
   "length": $frames,
   "batch_size": 1
  },
  "_meta": {
   "title": "AUTORIG_VIDEO_LATENT"
  }
 },
 "start_guide": {
  "class_type": "LTXVAddGuide",
  "inputs": {
   "positive": [
    "conditioning",
    0
   ],
   "negative": [
    "conditioning",
    1
   ],
   "latent": [
    "video_latent",
    0
   ],
   "vae": [
    "model",
    2
   ],
   "image": [
    "start_preprocess",
    0
   ],
   "frame_idx": 0,
   "strength": 0.7
  },
  "_meta": {
   "title": "AUTORIG_START_GUIDE"
  }
 },
 "end_frame": {
  "class_type": "LoadImage",
  "inputs": {
   "image": "$image_end"
  },
  "_meta": {
   "title": "Load end frame"
  }
 },
 "end_scale": {
  "class_type": "ImageScale",
  "inputs": {
   "image": [
    "end_frame",
    0
   ],
   "width": $width,
   "height": $height,
   "crop": "center",
   "upscale_method": "lanczos"
  },
  "_meta": {
   "title": "Scale end frame"
  }
 },
 "end_preprocess": {
  "class_type": "LTXVPreprocess",
  "inputs": {
   "image": [
    "end_scale",
    0
   ],
   "img_compression": 18
  },
  "_meta": {
   "title": "Preprocess end frame"
  }
 },
 "end_guide": {
  "class_type": "LTXVAddGuide",
  "inputs": {
   "positive": [
    "start_guide",
    0
   ],
   "negative": [
    "start_guide",
    1
   ],
   "latent": [
    "start_guide",
    2
   ],
   "vae": [
    "model",
    2
   ],
   "image": [
    "end_preprocess",
    0
   ],
   "frame_idx": -1,
   "strength": 0.7
  },
  "_meta": {
   "title": "AIGent optional end-frame guide"
  }
 },
 "audio_latent": {
  "class_type": "LTXVEmptyLatentAudio",
  "inputs": {
   "audio_vae": [
    "audio_vae",
    0
   ],
   "batch_size": 1,
   "frame_rate": $fps,
   "frames_number": $frames
  },
  "_meta": {
   "title": "AUTORIG_AUDIO_LATENT"
  }
 },
 "av_latent": {
  "class_type": "LTXVConcatAVLatent",
  "inputs": {
   "video_latent": [
    "end_guide",
    2
   ],
   "audio_latent": [
    "audio_latent",
    0
   ]
  }
 },
 "noise": {
  "class_type": "RandomNoise",
  "inputs": {
   "noise_seed": 43
  },
  "_meta": {
   "title": "AUTORIG_SEED"
  }
 },
 "sampler": {
  "class_type": "KSamplerSelect",
  "inputs": {
   "sampler_name": "euler_ancestral"
  }
 },
 "sigmas": {
  "class_type": "ManualSigmas",
  "inputs": {
   "sigmas": "1.000, 0.955, 0.893, 0.812, 0.715, 0.603, 0.482, 0.241, 0.121, 0.0"
  },
  "_meta": {
   "title": "10Eros author schedule (9 steps)"
  }
 },
 "guider": {
  "class_type": "CFGGuider",
  "inputs": {
   "model": [
    "eros_dmd_lora",
    0
   ],
   "positive": [
    "end_guide",
    0
   ],
   "negative": [
    "end_guide",
    1
   ],
   "cfg": 1.0
  }
 },
 "sample": {
  "class_type": "SamplerCustomAdvanced",
  "inputs": {
   "noise": [
    "noise",
    0
   ],
   "guider": [
    "guider",
    0
   ],
   "sampler": [
    "sampler",
    0
   ],
   "sigmas": [
    "sigmas",
    0
   ],
   "latent_image": [
    "av_latent",
    0
   ]
  }
 },
 "separate": {
  "class_type": "LTXVSeparateAVLatent",
  "inputs": {
   "av_latent": [
    "sample",
    0
   ]
  }
 },
 "crop_guides": {
  "class_type": "LTXVCropGuides",
  "inputs": {
   "positive": [
    "end_guide",
    0
   ],
   "negative": [
    "end_guide",
    1
   ],
   "latent": [
    "separate",
    0
   ]
  },
  "_meta": {
   "title": "AUTORIG_CROP_GUIDE_LATENTS"
  }
 },
 "decode_video": {
  "class_type": "VAEDecodeTiled",
  "inputs": {
   "vae": [
    "model",
    2
   ],
   "samples": [
    "crop_guides",
    2
   ],
   "tile_size": 512,
   "overlap": 64,
   "temporal_size": 64,
   "temporal_overlap": 16
  },
  "_meta": {
   "title": "AUTORIG_VIDEO_DECODE"
  }
 },
 "decode_audio": {
  "class_type": "LTXVAudioVAEDecode",
  "inputs": {
   "samples": [
    "separate",
    1
   ],
   "audio_vae": [
    "audio_vae",
    0
   ]
  }
 },
 "create_video": {
  "class_type": "CreateVideo",
  "inputs": {
   "images": [
    "decode_video",
    0
   ],
   "audio": [
    "decode_audio",
    0
   ],
   "fps": $fps
  },
  "_meta": {
   "title": "AUTORIG_OUTPUT_VIDEO"
  }
 },
 "save": {
  "class_type": "SaveVideo",
  "inputs": {
   "video": [
    "create_video",
    0
   ],
   "filename_prefix": "$output_url",
   "format": "mp4",
   "codec": "h264"
  },
  "_meta": {
   "title": "AUTORIG_OUTPUT"
  }
 },
 "eros_dmd_lora": {
  "class_type": "LoraLoaderModelOnly",
  "inputs": {
   "model": [
    "model",
    0
   ],
   "lora_name": "ltx10eros_v14_dmd_lora_2989633.safetensors",
   "strength_model": 1.0
  },
  "_meta": {
   "title": "AUTORIG_10EROS_DMD_LORA (step distill the 9-step schedule needs)"
  }
 }
}
