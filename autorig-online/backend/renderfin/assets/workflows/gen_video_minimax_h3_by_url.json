{
 "model": {
  "class_type": "UNETLoader",
  "inputs": {
   "unet_name": "minimax_h3_fl2va_pruned_int8_convrot.safetensors",
   "weight_dtype": "default"
  }
 },
 "turbo_lora": {
  "class_type": "LoraLoaderModelOnly",
  "inputs": {
   "model": [
    "model",
    0
   ],
   "lora_name": "minimax_h3_fl2v_turbo_4step_v1.2_768p_comfyui_bf16.safetensors",
   "strength_model": 1.0
  },
  "_meta": {
   "title": "MiniMax H3 turbo distill"
  }
 },
 "clip": {
  "class_type": "CLIPLoader",
  "inputs": {
   "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
   "type": "minimax",
   "device": "default"
  }
 },
 "video_vae": {
  "class_type": "VAELoader",
  "inputs": {
   "vae_name": "minimax_h3_video_vae_fp16.safetensors"
  }
 },
 "audio_vae": {
  "class_type": "VAELoader",
  "inputs": {
   "vae_name": "minimax_h3_audio_vae_fp32.safetensors"
  }
 },
 "start_frame": {
  "class_type": "LoadImage",
  "inputs": {
   "image": "$image"
  },
  "_meta": {
   "title": "AUTORIG_START_FRAME"
  }
 },
 "start_scale": {
  "class_type": "ImageScale",
  "inputs": {
   "image": [
    "start_frame",
    0
   ],
   "width": $width,
   "height": $height,
   "crop": "center",
   "upscale_method": "lanczos"
  }
 },
 "size": {
  "class_type": "GetImageSize",
  "inputs": {
   "image": [
    "start_scale",
    0
   ]
  }
 },
 "i2v": {
  "class_type": "MiniMaxH3ImageToVideo",
  "inputs": {
   "clip": [
    "clip",
    0
   ],
   "vae": [
    "video_vae",
    0
   ],
   "prompt": "$prompt",
   "width": [
    "size",
    0
   ],
   "height": [
    "size",
    1
   ],
   "length": $frames,
   "first_frame": [
    "start_scale",
    0
   ]
  },
  "_meta": {
   "title": "AUTORIG_IMAGE_TO_VIDEO"
  }
 },
 "end_frame": {
  "class_type": "LoadImage",
  "inputs": {
   "image": "$image_end"
  },
  "_meta": {
   "title": "Load end frame"
  }
 },
 "end_scale": {
  "class_type": "ImageScale",
  "inputs": {
   "image": [
    "end_frame",
    0
   ],
   "width": $width,
   "height": $height,
   "crop": "center",
   "upscale_method": "lanczos"
  },
  "_meta": {
   "title": "Scale end frame"
  }
 },
 "end_guide": {
  "class_type": "MiniMaxH3AddGuide",
  "inputs": {
   "positive": [
    "i2v",
    0
   ],
   "latent": [
    "i2v",
    1
   ],
   "frame_idx": -1,
   "vae": [
    "video_vae",
    0
   ],
   "image": [
    "end_scale",
    0
   ]
  },
  "_meta": {
   "title": "AIGent optional end-frame guide"
  }
 },
 "noise": {
  "class_type": "RandomNoise",
  "inputs": {
   "noise_seed": 43
  },
  "_meta": {
   "title": "AUTORIG_SEED"
  }
 },
 "sampler": {
  "class_type": "KSamplerSelect",
  "inputs": {
   "sampler_name": "res_multistep"
  }
 },
 "scheduler": {
  "class_type": "BasicScheduler",
  "inputs": {
   "model": [
    "turbo_lora",
    0
   ],
   "scheduler": "simple",
   "steps": 4,
   "denoise": 1.0
  }
 },
 "guider": {
  "class_type": "BasicGuider",
  "inputs": {
   "model": [
    "turbo_lora",
    0
   ],
   "conditioning": [
    "end_guide",
    0
   ]
  }
 },
 "sample": {
  "class_type": "SamplerCustomAdvanced",
  "inputs": {
   "noise": [
    "noise",
    0
   ],
   "guider": [
    "guider",
    0
   ],
   "sampler": [
    "sampler",
    0
   ],
   "sigmas": [
    "scheduler",
    0
   ],
   "latent_image": [
    "i2v",
    1
   ]
  }
 },
 "decode_video": {
  "class_type": "VAEDecode",
  "inputs": {
   "samples": [
    "sample",
    0
   ],
   "vae": [
    "video_vae",
    0
   ]
  }
 },
 "decode_audio": {
  "class_type": "VAEDecodeAudio",
  "inputs": {
   "samples": [
    "sample",
    0
   ],
   "vae": [
    "audio_vae",
    0
   ]
  }
 },
 "create_video": {
  "class_type": "CreateVideo",
  "inputs": {
   "images": [
    "decode_video",
    0
   ],
   "audio": [
    "decode_audio",
    0
   ],
   "fps": $fps
  },
  "_meta": {
   "title": "AUTORIG_OUTPUT_VIDEO"
  }
 },
 "save": {
  "class_type": "SaveVideo",
  "inputs": {
   "video": [
    "create_video",
    0
   ],
   "filename_prefix": "$output_url",
   "format": "mp4",
   "codec": "h264"
  },
  "_meta": {
   "title": "AUTORIG_OUTPUT"
  }
 }
}
