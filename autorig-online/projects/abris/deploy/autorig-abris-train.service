[Unit]
Description=Evaluate curated Abris number corrections and promote a qualifying model
ConditionPathExists=/srv/autorig/abris/training/enable
ConditionPathExistsGlob=/srv/autorig/abris/training/corrections/*.json

[Service]
Type=oneshot
User=autorig-abris-training
Group=autorig-abris-training
SupplementaryGroups=autorig-abris
EnvironmentFile=/srv/autorig/abris/deploy/training.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=OMP_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
Environment=OPENCV_FOR_THREADS_NUM=1
ExecStart=/usr/bin/env ${ABRIS_TRAIN_PYTHON} ${ABRIS_TRAIN_SCRIPT} /srv/autorig/abris/training/corrections --promote /srv/autorig/abris/training/models/model.npz
Nice=15
CPUQuota=40%
MemoryMax=768M
TasksMax=32
TimeoutStartSec=30min
NoNewPrivileges=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
ReadOnlyPaths=/srv/autorig/abris/training/corrections
ReadWritePaths=/srv/autorig/abris/training/models
UMask=0027
