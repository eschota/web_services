[Unit]
Description=AutoRig Abris recognition (%i)
After=network.target

[Service]
Type=simple
User=autorig-abris
Group=autorig-abris
EnvironmentFile=/srv/autorig/abris/deploy/%i.env
Environment=PATH=/srv/autorig/abris/runtime/tesseract/usr/bin:/usr/bin:/bin
Environment=LD_LIBRARY_PATH=/srv/autorig/abris/runtime/tesseract/usr/lib/x86_64-linux-gnu
Environment=TESSDATA_PREFIX=/srv/autorig/abris/runtime/tesseract/usr/share/tesseract-ocr/5/tessdata
Environment=TMPDIR=/srv/autorig/abris/tmp
Environment=ABRIS_DXF2DWG=/srv/autorig/abris/tools/libredwg-0.14/bin/dxf2dwg
Environment=ABRIS_DWG_WORKDIR=/srv/autorig/abris/tmp
Environment=ABRIS_HTR_MODEL=/srv/autorig/abris/training/models/model.npz
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=OMP_NUM_THREADS=1
Environment=OMP_THREAD_LIMIT=1
Environment=MKL_NUM_THREADS=1
Environment=OPENCV_FOR_THREADS_NUM=1
ExecStart=/usr/bin/env ${ABRIS_GUNICORN} --chdir ${ABRIS_BACKEND_DIR} --bind 127.0.0.1:${ABRIS_PORT} --workers 2 --threads 1 --timeout 165 --graceful-timeout 170 --backlog 8 --worker-tmp-dir /srv/autorig/abris/tmp --error-logfile - server:application
Restart=on-failure
RestartSec=2
TimeoutStopSec=175
CPUQuota=200%
MemoryMax=1500M
TasksMax=64
NoNewPrivileges=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
ReadWritePaths=/srv/autorig/abris/tmp
UMask=0077

[Install]
WantedBy=multi-user.target
