# deploy/vehicle/autorig-masks-tunnels.service (2026-10-15, «разнести на флот»): the same farm-tunnels.sh as the converter /
# Hunyuan tunnels, its own conf and unit, so adding a mask port never restarts the converter tunnels.
#   conf /srv/autorig/secrets/masks-tunnels.conf: <name> <ssh_port> <local_port> <remote_port>
[Unit]
Description=AutoRig vehicle mask service SSH tunnels to the farm boxes (f1 f2 f5 f7 f13)
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/srv/autorig

[Service]
Type=simple
User=autorig
Group=autorig
Slice=autorig.slice
Environment="HOME=/srv/autorig/home"
Environment="FARM_TUNNELS_CONF=/srv/autorig/secrets/masks-tunnels.conf"
Environment="FARM_TUNNELS_KEY=/srv/autorig/secrets/ssh/renderfin_farm_tunnel"
ExecStart=/srv/autorig/current/autorig-online/deploy/renderfin-farm-tunnels/farm-tunnels.sh
Restart=always
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/srv/autorig/home

[Install]
WantedBy=multi-user.target
