# Renderfin service environment (install as /etc/autorig-renderfin.env)

# Data root: render artifacts, sqlite db, worker registry
RENDERFIN_DATA_DIR=/var/autorig/renderfin

# Public base for output_url construction (served by nginx alias /renderfin/render/)
RENDERFIN_PUBLIC_BASE_URL=https://autorig.online/renderfin

# Plain-HTTP ComfyUI worker hosts the adapter may talk to (anti-SSRF allowlist)
RENDERFIN_ALLOWED_HTTP_HOSTS=5.129.157.224,37.192.2.126,127.0.0.1,localhost

# Basic auth "user:password" for HTTPS worker edges (worker-4090.renderfin.qwertystock.com)
#RENDERFIN_WORKER_BASIC_AUTH=user:password

# Hunyuan3D image-to-3D via converter workers (preferred over ComfyUI when token set).
# Enabled+installed as of 2026-07: F2, F7, F13. Token lives on the workers as
# %LOCALAPPDATA%\AutoRig\hunyuan_api_token — use the same value here.
#HUNYUAN_API_TOKEN=...
#RENDERFIN_HUNYUAN_WORKERS=https://converter-f2.freestock.online,https://converter-f7.freestock.online,https://converter-f13.freestock.online
#RENDERFIN_HUNYUAN_QUALITY=standard

# Queue tuning (defaults shown)
#RENDERFIN_TASK_TIMEOUT_SECONDS=1800
#RENDERFIN_PUMP_TICK_SECONDS=1.5
#RENDERFIN_DISPATCH_INTERVAL_SECONDS=5

# Turntable renderer (node + headless chrome + ffmpeg on this host)
#RENDERFIN_TURNTABLE_NODE=node
#RENDERFIN_TURNTABLE_SCRIPT=/root/autorig-online/tools/renderfin/glb_turntable.mjs
#RENDERFIN_TURNTABLE_CHROME=/usr/bin/chromium
#RENDERFIN_TURNTABLE_FFMPEG=ffmpeg
#RENDERFIN_TURNTABLE_SECONDS=6
