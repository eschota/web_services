[Unit]
Description=AutoRig intensive 72-hour post-migration monitor
After=network-online.target autorig-storage.service autorig-storage-renderfin.service
Wants=network-online.target
RequiresMountsFor=/srv/autorig

[Service]
Type=oneshot
User=autorig
Group=autorig
SupplementaryGroups=systemd-journal
Slice=autorig.slice
WorkingDirectory=/srv/autorig/current/autorig-online/backend
Environment="PYTHONPATH=/srv/autorig/current/autorig-online/backend"
Environment="AUTORIG_POSTMIGRATION_DB=/srv/autorig/data/db/autorig.db"
Environment="AUTORIG_POSTMIGRATION_STATE_DIR=/var/lib/autorig-postmigration-monitor"
Environment="AUTORIG_POSTMIGRATION_DURATION_HOURS=72"
Environment="AUTORIG_POSTMIGRATION_FULL_CHECK_MINUTES=60"
Environment="AUTORIG_POSTMIGRATION_EMAIL_PROBE_HOURS=12"
Environment="AUTORIG_POSTMIGRATION_EMAIL_GRACE_MINUTES=15"
Environment="AUTORIG_POSTMIGRATION_CACHE_STALL_HOURS=6"
Environment="AUTORIG_POSTMIGRATION_MIN_FREE_GB=60"
Environment="AUTORIG_HEALTHCHECK_RENDERFIN_URL=http://127.0.0.1:8210/renderfin"
Environment="AUTORIG_HEALTHCHECK_SERVICES=autorig-storage,autorig-storage-renderfin,autorig-storage-telegram,autorig-storage-tunnels"
Environment="AUTORIG_HEALTHCHECK_CHARGEN_DB=/srv/autorig/data/var/renderfin/db/renderfin.db"
Environment="AUTORIG_HEALTHCHECK_DB=/srv/autorig/data/db/autorig.db"
Environment="AUTORIG_HEALTHCHECK_VIDEO_CACHE=/srv/autorig/data/var/videos"
Environment="AUTORIG_HEALTHCHECK_BACKEND_ENV=/srv/autorig/secrets/backend.env"
Environment="AUTORIG_HEALTHCHECK_HUNYUAN_WORKERS_FILE=/srv/autorig/secrets/renderfin-hunyuan.json"
Environment="AUTORIG_HEALTHCHECK_TUNNELS_CONF=/srv/autorig/secrets/farm-tunnels.conf"
Environment="AUTORIG_HEALTHCHECK_MIN_FREE_GB=60"
Environment="AUTORIG_HEALTHCHECK_VIDEO_CACHE_WARN_GB=20"
EnvironmentFile=-/srv/autorig/secrets/backend.env
EnvironmentFile=/srv/autorig/secrets/telegram.env
EnvironmentFile=/srv/autorig/secrets/storage-host.env
ExecStart=/srv/autorig/venv/bin/python3 /srv/autorig/current/autorig-online/deploy/healthcheck/postmigration_monitor.py
ExecStartPost=+/bin/bash -c 'if test -f /var/lib/autorig-postmigration-monitor/postmigration-72h.complete; then /bin/systemctl disable --now autorig-storage-postmigration-monitor.timer; fi'
SuccessExitStatus=0 1
StateDirectory=autorig-postmigration-monitor
StateDirectoryMode=0750
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/srv/autorig/data/db
