[Unit]
Description=AutoRig Renderfin (storage host)
After=network-online.target autorig-storage-tunnels.service
Wants=network-online.target
RequiresMountsFor=/srv/autorig

[Service]
Type=simple
User=autorig
Group=autorig
Slice=autorig.slice
WorkingDirectory=/srv/autorig/current/autorig-online/backend
Environment="HOME=/srv/autorig/home"
Environment="PATH=/srv/autorig/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONUNBUFFERED=1"
EnvironmentFile=-/srv/autorig/secrets/backend.env
EnvironmentFile=-/srv/autorig/secrets/telegram.env
EnvironmentFile=-/srv/autorig/secrets/renderfin.env
EnvironmentFile=/srv/autorig/secrets/storage-host.env
ExecStart=/srv/autorig/venv/bin/python3 -m uvicorn renderfin.app:app --host 127.0.0.1 --port 8210 --workers 1 --no-access-log
Restart=always
RestartSec=5
TimeoutStopSec=60
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/srv/autorig/data /srv/autorig/home

[Install]
WantedBy=multi-user.target
