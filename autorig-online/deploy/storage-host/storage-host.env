# Non-secret overrides loaded after the migrated production environment.
APP_URL=https://autorig.online
DATABASE_URL=sqlite+aiosqlite:////srv/autorig/data/db/autorig.db
UPLOAD_DIR=/srv/autorig/data/var/uploads
VIEWER_DEFAULT_SETTINGS_PATH=/srv/autorig/data/var/viewer_default_settings.json
ANIMATION_LIBRARY_ROOT=/srv/autorig/data/var/animation-library
ANIMATION_FITTING_JOBS_ROOT=/srv/autorig/data/var/animation-fitting/jobs
RENDERFIN_DATA_DIR=/srv/autorig/data/var/renderfin
RENDERFIN_PUBLIC_BASE_URL=https://autorig.online/renderfin
RENDERFIN_INTERNAL_URL=http://127.0.0.1:8210/renderfin
RENDERFIN_HUNYUAN_WORKERS_FILE=/srv/autorig/secrets/renderfin-hunyuan.json
RENDERFIN_AUTORIG_QUEUE_DB_PATH=/srv/autorig/data/db/autorig.db
RENDERFIN_HUNYUAN_RESERVED_WORKERS=2
RENDERFIN_TURNTABLE_SCRIPT=/srv/autorig/current/autorig-online/tools/renderfin/glb_turntable.mjs
RENDERFIN_TURNTABLE_CHROME=/usr/bin/chromium
RENDERFIN_TURNTABLE_FFMPEG=/usr/bin/ffmpeg
AUTORIG_VISION_CONFIG=/srv/autorig/secrets/ai_vision_animal_type_detect.json
AUTORIG_DISABLED_WORKERS=
AUTORIG_TRANSIENT_DISPATCH_COOLDOWN=600
# Shared GPU workload broker.  The four scoped bearer credentials are secret
# and belong in /srv/autorig/secrets/backend.env as
# AUTORIG_WORKLOAD_BROKER_{GATEWAY,RENDERFIN,HOST_AGENT,ADMIN}_TOKEN.
# The broker stays fail-closed by code default.  API-only staging may set
# AUTORIG_WORKLOAD_BROKER_API_ENABLED=1 so authenticated host agents can prove
# readiness without changing AutoRig dispatch.  Lease enforcement remains off
# until AUTORIG_WORKLOAD_BROKER_ENABLED=1 is set after the worker rollout.
# If Gateway AI Vision is already using the live broker while dedicated
# AutoRig-primary reserve converters still lack protected machine_* identity,
# keep AUTORIG_WORKLOAD_BROKER_ENABLED=1 and temporarily set
# AUTORIG_WORKLOAD_BROKER_AUTORIG_ENFORCED=0. Only dedicated AutoRig reserves
# may be enabled in worker_endpoints during that transition. Remove the
# override after their exact identity/role canary succeeds.
AUTORIG_WORKLOAD_AUTORIG_RESERVE=2
AUTORIG_WORKLOAD_NODE_HEARTBEAT_TTL=180
AUTORIG_WORKLOAD_WAITER_TTL=90
AUTORIG_WORKLOAD_NODE_ALIASES_JSON={"raptor":"raptor","raptor-gpu0":"raptor","ryzen-server":"raptor","ryzen_server":"raptor"}
ARTIFACT_CACHE_ROOT=/srv/autorig/data/artifact-cache
ARTIFACT_CACHE_FULL_HOURS=24
ARTIFACT_CACHE_SOFT_CAP_GB=250
ARTIFACT_CACHE_RESERVE_GB=65
ARTIFACT_CACHE_CONCURRENCY=2
MIN_FREE_SPACE_GB=60
NEW_TASK_MIN_FREE_GB=60
DISK_RECOVERY_FREE_GB=65
DISK_ALERT_REMINDER_HOURS=24
DISK_PRESSURE_STATE_PATH=/srv/autorig/data/var/disk_pressure_alert_state.json
TASK_CACHE_MAX_GB=250
PERIODIC_TASK_CACHE_MAX_GB=250
GLB_CACHE_MAX_GB=250
PERIODIC_TASK_CACHE_MIN_AGE_HOURS=24
GLB_CACHE_MIN_AGE_HOURS=24
UPLOAD_PRESSURE_CLEANUP_MIN_AGE_HOURS=72
VIDEO_CACHE_MIN_AGE_HOURS=72
AUTOMATIC_TASK_DB_DELETION=0
