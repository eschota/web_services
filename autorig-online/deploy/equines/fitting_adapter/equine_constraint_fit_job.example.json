{
  "schema": "autorig.equine-constraint-fit-job/1",
  "action_id": "walk_forward",
  "bundle_manifest": {"path": "<immutable actionless bundle>/immutable_manifest.json", "sha256": "<sha256>"},
  "surface_anchors": {"path": "<immutable actionless bundle>/surface_anchors.json", "sha256": "<sha256>"},
  "constraints": {"path": "<equine_limb_constraints output.json>", "sha256": "<sha256>"},
  "contact_evidence": {"path": "<measured contact evidence.json>", "sha256": "<sha256>"},
  "source_eligibility": {"path": "<source-bound target eligibility.json>", "sha256": "<sha256>"},
  "profile": {"path": "<run-scoped engineering profile.json>", "sha256": "<sha256>"},
  "solver_control_profile": {"path": "<optional solver-control profile.json>", "sha256": "<sha256>"},
  "action_contract": {"path": "<full34 walk action contract.json>", "sha256": "<sha256>"},
  "animation_fitting_code": "<managed runtime>/code/animation_fitting",
  "output": "<fresh work root>/walk-fitted-animation.json",
  "progress_file": "<fresh work root>/walk-fitted-animation.progress.json",
  "resume_from": {"path": "<optional prior diagnostic progress.json>", "sha256": "<exact sha256>"},
  "diagnostic_audit": {
    "fitter_code_sha256": "<exact staged equine_constraint_fit.py sha256>",
