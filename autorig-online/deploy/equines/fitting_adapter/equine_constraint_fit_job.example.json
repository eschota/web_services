    "finite_difference_step": 0.000001,
    "unexpected_derivative_tolerance": 0.0000001,
    "output": "<fresh work root>/window-45-jacobian-audit.json"
  },
  "options": {
    "max_rotation_delta_rad": 0.75,
    "rest_weight": 0.01,
    "temporal_weight": 0.05,
    "max_nfev": 250,
    "target_scale": 1.0
    ,"max_root_translation_height_ratio": 0.5
    ,"max_fit_seconds": 300
    ,"hoof_huber_delta_height_ratio": 0.05
    ,"joint_huber_delta_height_ratio": 0.05
    ,"limb_torso_vertical_weight": 1.0
    ,"solver_ftol": 0.00000001
    ,"solver_xtol": 0.00000001
    ,"solver_gtol": 0.00000001
    ,"solver_x_scale": 1.0
  }
}
