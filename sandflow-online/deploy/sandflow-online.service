[Unit]
Description=SandFlow isolated lobby and client-physics relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sandflow
Group=sandflow
WorkingDirectory=/srv/sandflow/current
ExecStart=/srv/sandflow/current/SandFlow.Server --urls http://127.0.0.1:8270
Environment=SANDFLOW_DATA=/srv/sandflow/data
Environment=SANDFLOW_ADMISSION_ENABLED=false
Environment=SANDFLOW_VOICE_ENABLED=false
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
Environment=TMPDIR=/srv/sandflow/.work/tmp
EnvironmentFile=-/srv/sandflow/secrets/server.env
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
CPUQuota=100%
MemoryMax=768M
TasksMax=128
LimitNOFILE=8192
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/sandflow/data /srv/sandflow/.work/tmp
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
