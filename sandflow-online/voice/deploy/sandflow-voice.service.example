[Unit]
# Legacy Docker example only. Prefer deploy/binary/sandflow-voice.service.example
# on way-fr so SandFlow does not depend on the existing broken docker.service unit.
Description=SandFlow self-hosted voice SFU
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/root/sandflow-online/voice/deploy
ExecStart=/usr/bin/docker compose -f docker-compose.example.yml up -d
ExecStop=/usr/bin/docker compose -f docker-compose.example.yml down
TimeoutStartSec=120
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
