{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autorig.online/schemas/autorig-cloth.v1.schema.json",
  "title": "AutoRig cloth manifest v1",
  "description": "Bone chains, presets and body colliders for simulating hair and clothing on a rigged character. See cloth-manifest-v1.md.",
  "type": "object",
  "required": ["format", "version", "units", "calibration", "presets", "groups", "colliders"],
  "properties": {
    "format": { "const": "autorig.cloth" },
    "version": { "const": 1 },
    "generator": { "type": "string" },
    "units": { "const": "meters" },
    "calibration": {
      "type": "object",
      "required": ["bone_a", "bone_b", "distance"],
      "properties": {
        "bone_a": { "type": "string", "minLength": 1 },
        "bone_b": { "type": "string", "minLength": 1 },
        "distance": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "presets": {
      "type": "array",
      "items": { "$ref": "#/$defs/preset" }
    },
    "groups": {
      "type": "array",
      "items": { "$ref": "#/$defs/group" }
    },
    "colliders": {
      "type": "array",
      "items": { "$ref": "#/$defs/collider" }
    }
  },
  "$defs": {
    "unit": { "type": "number", "minimum": 0, "maximum": 1 },
    "preset": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "gravity": { "type": "number", "minimum": 0, "maximum": 2 },
        "damping": { "$ref": "#/$defs/unit" },
        "stiffness": { "$ref": "#/$defs/unit" },
        "angle_limit_deg": { "type": "number", "minimum": 0, "maximum": 180 },
        "stretch": { "$ref": "#/$defs/unit" },
        "connection_stiffness": { "$ref": "#/$defs/unit" },
        "radius": { "type": "number", "minimum": 0 },
        "radius_tip": { "type": "number", "minimum": 0 },
        "inertia_move": { "$ref": "#/$defs/unit" },
        "inertia_rotate": { "$ref": "#/$defs/unit" },
        "drag": { "$ref": "#/$defs/unit" },
        "wind": { "$ref": "#/$defs/unit" }
      }
    },
    "chain": {
      "type": "object",
      "required": ["bones"],
      "properties": {
        "bones": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "group": {
      "type": "object",
      "required": ["name", "kind", "attach_bone", "preset", "connection", "chains"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["hair", "cloth", "tail", "accessory"] },
        "attach_bone": { "type": "string", "minLength": 1 },
        "preset": { "type": "string", "minLength": 1 },
        "connection": { "enum": ["none", "open", "loop"] },
        "collider_tags": { "type": "array", "items": { "type": "string" } },
        "chains": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/chain" }
        }
      }
    },
    "collider": {
      "type": "object",
      "required": ["name", "shape", "bone", "radius"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "shape": { "enum": ["sphere", "capsule"] },
        "bone": { "type": "string", "minLength": 1 },
        "to_bone": { "type": "string" },
        "t": { "$ref": "#/$defs/unit" },
        "radius": { "type": "number", "exclusiveMinimum": 0 },
        "radius_to": { "type": "number", "minimum": 0 }
      },
      "allOf": [
        {
          "if": { "properties": { "shape": { "const": "capsule" } } },
          "then": {
            "required": ["to_bone"],
            "properties": { "to_bone": { "type": "string", "minLength": 1 } }
          }
        }
      ]
    }
  }
}
