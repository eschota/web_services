<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles package/Runtime/Core directly, with no Unity references: a Core file that touches
       UnityEngine fails this build. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>AutoRig.Cloth.Core.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(PackageRoot)Runtime/Core/**/*.cs" LinkBase="Core" />
    <Compile Include="*.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../spec/cloth-manifest.v1.schema.json" Link="spec/cloth-manifest.v1.schema.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../spec/builtin-presets.v1.json" Link="spec/builtin-presets.v1.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../spec/examples/*.json" LinkBase="spec/examples" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="JsonSchema.Net" Version="7.3.4" />
  </ItemGroup>
</Project>
