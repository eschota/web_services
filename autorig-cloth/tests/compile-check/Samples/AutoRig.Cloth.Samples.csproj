<Project Sdk="Microsoft.NET.Sdk">
  <!-- package/Samples~ scripts: compiled into the user's project once imported, against the runtime. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>AutoRig.Cloth.Samples</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(PackageRoot)Samples~/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Runtime/AutoRig.Cloth.csproj" />
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.33" />
  </ItemGroup>
</Project>
