<Project Sdk="Microsoft.NET.Sdk">
  <!-- package/Runtime (Core + Components + Setup) against the Unity 2021.3 engine reference
       assemblies: the same code the AutoRig.Cloth.asmdef compiles inside Unity. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>AutoRig.Cloth</AssemblyName>
    <RootNamespace>AutoRig.Cloth</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(PackageRoot)Runtime/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.33" />
  </ItemGroup>
</Project>
