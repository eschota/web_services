[Unit]
Description=QwertyStock VPN 3proxy
After=network.target

[Service]
Type=forking
PIDFile=/run/3proxy.pid
LimitNOFILE=1048576
ExecStart=/usr/local/bin/3proxy /root/qwerty_vpn/proxy/3proxy.cfg
ExecReload=/bin/kill -USR1 $MAINPID
# Access traffic is already written by 3proxy's `log` directive. Do not
# duplicate the high-volume stream into journald/rsyslog.
StandardOutput=null
StandardError=journal
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
